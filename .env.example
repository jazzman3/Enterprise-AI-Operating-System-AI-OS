# Local use only! For production configure AISX_IDENTITIES_JSON with generated secrets.
AISX_ALLOW_LOCAL_DEMO=true
AISX_DB_PATH=/app/data/aisx.db
AISX_ENABLE_DOCS=true
# Example secure production setting (replace keys and tenant names, NEVER commit real values):
# AISX_IDENTITIES_JSON=[{"tenant":"tenant-a","role":"analyst","user":"example-analyst","key":"GENERATED_SECRET_AT_LEAST_24_CHARS"},{"tenant":"tenant-a","role":"approver","user":"example-reviewer","key":"ANOTHER_GENERATED_SECRET_24_CHARS"},{"tenant":"tenant-a","role":"admin","user":"example-admin","key":"THIRD_GENERATED_SECRET_24_CHARS"}]
